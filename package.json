{
  "name": "hcfi-credit-sims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3070 --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p ${PORT:-8080}",
    "lint": "eslint",
    "postinstall": "node scripts/setup-prisma.js",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate && npm run postinstall",
    "db:studio": "prisma studio",
    "test:simulate": "tsx --env-file=.env scripts/test-hyundai-simulate.ts",
    "migrate:s3-proxy": "tsx --env-file=.env scripts/migrate-s3-urls-to-proxy.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.19.1",
    "@tabler/icons-react": "^3.34.0",
    "bcryptjs": "^3.0.3",
    "isomorphic-dompurify": "^2.35.0",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.7",
    "next": "16.1.2",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^3.26.5",
    "pg": "^8.17.1",
    "prisma": "^6.19.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.68.0",
    "sharp": "^0.34.5",
    "undici": "^7.21.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
